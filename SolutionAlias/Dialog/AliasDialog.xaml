<platformUi:DialogWindow
    x:Class="SolutionAlias.Dialog.AliasDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    toolkit:Themes.UseVsTheme="True"
    Title="Solution Alias"
    SizeToContent="WidthAndHeight"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    HasHelpButton="False">

    <platformUi:DialogWindow.Resources>
        <!-- A colour swatch: a RadioButton drawn as a filled square, with a ring when checked. -->
        <ControlTemplate x:Key="SwatchTemplate" TargetType="{x:Type RadioButton}">
            <Border x:Name="Ring" Width="30" Height="30" Margin="0,0,4,4" Padding="2" CornerRadius="4"
                    BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                <Border CornerRadius="2" BorderThickness="1" BorderBrush="#40808080" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </platformUi:DialogWindow.Resources>

    <StackPanel Margin="16" Width="460">
        <Label Content="_Alias:" Target="{Binding ElementName=AliasTextBox}" Padding="0,0,0,4" />
        <TextBox x:Name="AliasTextBox" MaxLength="40" TextChanged="OnAliasTextChanged" />
        <TextBlock Text="Leave empty to show the solution file's path." Margin="0,4,0,0" Opacity="0.7" />

        <!-- Hidden when "Always use theme colour" is on -->
        <StackPanel x:Name="ColourChoices">
            <TextBlock Text="Text colour:" Margin="0,14,0,4" />
            <WrapPanel x:Name="TextColourSwatches" />

            <TextBlock Text="Background colour:" Margin="0,10,0,4" />
            <WrapPanel x:Name="BackgroundColourSwatches" />
        </StackPanel>

        <TextBlock Text="Preview:" Margin="0,10,0,4" />
        <Border Padding="8,6" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.MainWindowActiveCaptionBrushKey}}">
            <DockPanel LastChildFill="True">
                <Border x:Name="PreviewSolutionLabel" DockPanel.Dock="Left" MinHeight="24">
                    <TextBlock x:Name="PreviewSolutionName" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="PreviewAliasLabel" MinHeight="24" Margin="4,0,0,0" HorizontalAlignment="Left">
                    <TextBlock x:Name="PreviewAliasText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
            </DockPanel>
        </Border>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ClearButton" Grid.Column="0" Content="C_lear" MinWidth="75" Click="OnClearClick"
                    ToolTip="Remove this solution's alias and colours and delete its file. The label goes back to the solution path in Auto colours." />
            <Button Grid.Column="1" Content="_Options..." MinWidth="75" Margin="8,0,0,0" Click="OnOptionsClick"
                    ToolTip="Close this dialog without saving and open Tools > Options > Solution Alias." />
            <Button x:Name="OkButton" Grid.Column="3" Content="OK" MinWidth="75" IsDefault="True" Click="OnOkClick" />
            <Button Grid.Column="4" Content="Cancel" MinWidth="75" Margin="8,0,0,0" IsCancel="True" />
        </Grid>
    </StackPanel>
</platformUi:DialogWindow>
